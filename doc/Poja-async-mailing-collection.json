    {
      "name": "Images (async event)",
      "item": [
        {
          "name": "Submit Image - JPEG",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('imageId', json.id);",
                  "}",
                  "pm.test('Response has fileName and userEmail', function () {",
                  "    pm.expect(json).to.have.property('fileName');",
                  "    pm.expect(json).to.have.property('userEmail');",
                  "    pm.expect(json).to.have.property('createdAt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "email",
                  "value": "ilo.rakoto@example.com",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["images"]
            },
            "description": "Select a local .jpg or .png file for the 'file' field before sending. Saves the record synchronously, then asynchronously converts the image to black and white, uploads it to S3, and emails a download link to the given address."
          }
        },
        {
          "name": "Submit Image - Unsupported Content Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a non-image file (e.g. .txt or .pdf) to trigger the 400 response"
                },
                {
                  "key": "email",
                  "value": "ilo.rakoto@example.com",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["images"]
            }
          }
        },
        {
          "name": "Get All Images",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["images"]
            },
            "description": "Returns all submitted images, including the ones still being processed asynchronously."
          }
        }
